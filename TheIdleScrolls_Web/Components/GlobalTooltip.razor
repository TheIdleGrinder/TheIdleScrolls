@using TheIdleScrolls_Web.Services
@using System.Globalization
@inject TooltipService TooltipService
@implements IDisposable

@if (_request != null)
{
    <div class="global-tooltip" style="@_currentStyle" @ref="_tooltipElement">
        @_request.Content
    </div>
}

<style>
    .global-tooltip {
        position: fixed;
        z-index: 10000;
        pointer-events: none;
        /* background-color: var(--back-color, white); */
        /* border: 2px solid var(--frame-color, black); */
        /* padding: 10px; */
        box-shadow: 1px 1px 4px 4px rgba(0,0,0,0.3);
        /* max-width: 400px; */
        min-width: 200px;
        width: max-content;
        box-sizing: border-box;
    }
</style>

@code {
    private TooltipRequest? _request;
    private ElementReference _tooltipElement;
    private string _currentStyle = "";
    private bool _needsRepositioning = false;

    protected override void OnInitialized()
    {
        TooltipService.OnTooltipRequested += HandleTooltipRequest;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_needsRepositioning && _request != null)
        {
            _needsRepositioning = false;
            await CalculatePositionAsync();
        }
    }

    private void HandleTooltipRequest(TooltipRequest? request)
    {
        _request = request;
        
        if (request != null)
        {
            // Initial Position (centered over element)
            _currentStyle = GetInitialPositionStyle(request.Position);
            _needsRepositioning = true; // Flag for recalculation
        }
        else
        {
            _currentStyle = "";
            _needsRepositioning = false;
        }
        
        StateHasChanged();
    }
    
    private async Task CalculatePositionAsync()
    {
        if (_request == null) return;
        
        try
        {
            var position = await TooltipService.CalculatePositionAsync(_request.Position, _tooltipElement);
            
            if (position != null)
            {
                _currentStyle = string.Create(
                    CultureInfo.InvariantCulture,
                    $"left: {position.Left}px; top: {position.Top}px; transform: {position.Transform}; margin-top: {position.MarginTop}px;"
                );
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Tooltip positioning error: {ex.Message}");
        }
    }
    
    private string GetInitialPositionStyle(BoundingRect pos)
    {
        // Simple initial position (can be briefly visible)
        var left = pos.Left + (pos.Width / 2);
        var top = pos.Top;
        
        return string.Create(
            CultureInfo.InvariantCulture,
            $"left: {left}px; top: {top}px; transform: translate(-50%, -100%); margin-top: -10px; opacity: 0.5;"
        );
    }

    public void Dispose()
    {
        TooltipService.OnTooltipRequested -= HandleTooltipRequest;
    }
}