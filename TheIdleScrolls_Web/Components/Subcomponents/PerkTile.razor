@using TheIdleScrolls_Core
@using TheIdleScrolls_Core.Components
@using TheIdleScrolls_Core.Modifiers
@using TheIdleScrolls_Core.Skills
@using TheIdleScrolls_Web.Components.Subcomponents
@using TheIdleScrolls_Web.CoreWrapper

@inject CoreWrapperModel CoreWrapper

@implements IDisposable

<div class="perk @PerkClasses()">
    <div class="perk-top-row">
        <span class="perk-name">@GetTitleLine()</span>
        @if (Perk?.Permanent ?? false)
        {
            <span class="perk-always-active-indicator">Permanent</span>
        }
    </div>
    
    <div class="perk-description">@Perk?.Description</div>

    @if (Perk?.Modifiers.Count > 0)
    {
        <span>Current Level:</span>
        <div class="perk-modifiers">
            @foreach (var modifier in Perk?.Modifiers ?? [])
            {
                <div class="perk-modifier">➤ @ModifierPreface()@modifier.ToPrettyString()</div>
            }
        </div>
    }

    @if (Perk?.CurrentLevel < Perk?.MaxLevel)
    {
        <span>Next Level:</span>
        <div class="perk-modifiers">
            @foreach (var modifier in Perk!.ModifiersAtLevel(Perk!.CurrentLevel + 1))
            {
                <div class="perk-modifier">➤ @ModifierPreface()@modifier.ToPrettyString()</div>
            }
        </div>
    }

    @if (GetPerkSkill() is not null)
    {
        <span>Grants Skill:</span>
        <div class="perk-skill-frame">
            <SkillDisplayTile Skill=@GetPerkSkill()></SkillDisplayTile>
        </div>
    }

    @if (CanSetLevel().Reason != string.Empty)
    {
        @if (Refund)
        {
            <span>Refund:</span>
        }
        else
        {
            <span>Next Level:</span>
        }
        <div class="perk-modifier @(CanSetLevel().CanSet ? "" : "perk-unavailable-text")">
            @CanSetLevel().Reason
        </div>
    }

</div>

<style>
    .perk {
        width: 25rem;
        padding: 5px;
        border: 1px solid var(--frame-color);
        position: relative;
    }

    .perk-top-row {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
    }

    .perk-name {
        font-weight: bold;
    }

    .perk-description {
        margin: 2px;
    }

    .perk-modifier {
        margin: 2px;
        margin-left: 7px;
        font-style: italic;
        font-size: small;
    }

    .perk-active {
        color: black;
        background-color: var(--back-color-special);
    }

    .perk-inactive {
        color: gray;
        font-style: italic;
        background-color: white;
    }

    .perk-new {
        border-width: 3px;
    }

    .perk-new.perk-active {
        border-color: mediumseagreen;
    }

    .perk-new.perk-inactive {
        border-color: limegreen;
    }

    .perk-always-active {
        border: solid 2px var(--frame-color);
    }

    .perk-always-active-indicator {
        font-style: italic;
        font-size: smaller;
        color: var(--frame-color);
    }

    .perk-skill-frame {
        margin: 0.5rem;
        width: fit-content;
        border: 1px solid var(--frame-color);
    }

    .perk-unavailable-text {
        color: red;
        font-weight: bold;
    }

</style>

@code {
    [Parameter]
    public string PerkId { get; set; } = "";
    [Parameter]
    public PerksComponent? PerksComp { get; set; } = null;
    [Parameter]
    public bool IsNew { get; set; } = false;
    [Parameter]
    public bool Refund { get; set; } = false;

    private PerkUpdatedHandler? _perkUpdatedHandler;
    private DefenseChangedHandler? _playerDefenseChangedHandler;

    protected override void OnInitialized()
    {
        _perkUpdatedHandler = (string id) => {
            if (id == PerkId)
                StateHasChanged();
        };
        CoreWrapper.GameRunner.GetEventEmitter().PerkUpdated += _perkUpdatedHandler;

        if (Perk?.Skill is not null)
        {
            // CornerCut: Use PlayerDefenseChanged as a proxy for stat changes
            _playerDefenseChangedHandler = (_, _, _) =>
            {
                StateHasChanged();
            };
            CoreWrapper.GameRunner.GetEventEmitter().PlayerDefenseChanged += _playerDefenseChangedHandler;
        }

        base.OnInitialized();
    }

    public void Dispose()
    {
        if (_perkUpdatedHandler is not null)
        {
            CoreWrapper.GameRunner.GetEventEmitter().PerkUpdated -= _perkUpdatedHandler;
        }

        if (_playerDefenseChangedHandler is not null)
        {
            CoreWrapper.GameRunner.GetEventEmitter().PlayerDefenseChanged -= _playerDefenseChangedHandler;
        }
    }

    Perk? Perk => PerksComp?.GetPerks()?.FirstOrDefault(p => p.Id == PerkId);

    int PerkLevel => PerksComp?.GetPerkLevel(PerkId) ?? 0;
    bool IsActive => PerksComp?.IsPerkActive(PerkId) ?? false;
    int FreePerkPoints => PerksComp?.GetAvailablePerkPoints() ?? 0;

    string GetTitleLine() => Perk == null ? "" : $"{Perk.Name}" 
        + (Perk.MaxLevel > 1 ? $" ({PerksComp?.GetPerkLevel(Perk.Id) ?? 0}/{Perk.MaxLevel})" : "");

    bool CanIncreaseLevel()
    {
        if (Perk == null)
            return false;
        return PerkLevel < Perk.MaxLevel;
    }

    (bool CanSet, string Reason) CanSetLevel()
    {
        if (Refund)
        {
            if (PerkLevel == 0)
                return (false, "");
            return PerksComp?.CanSetPerkLevel(CoreWrapper.PlayerCharacter!, PerkId, PerkLevel - 1) 
                ?? (false, "Perk component not found");
        }
        else
        {
            if (PerkLevel == Perk?.MaxLevel)
                return (false, "");
            return PerksComp?.CanSetPerkLevel(CoreWrapper.PlayerCharacter!, PerkId, PerkLevel + 1)
                ?? (false, "Perk component not found");
        }
    }

    string PerkClasses()
    {
        if (Perk == null)
            return "";
        string classes = IsActive ? "perk-active" : "perk-inactive";
        if (Perk.Permanent)
            classes += " perk-always-active";
        if (IsNew)
            classes += " perk-new";
        return classes;
    }

    void SetLevel(int level)
    {
        if (CoreWrapper.PlayerCharacter == null)
            return;
        CoreWrapper.InputHandler.SetPerkLevel(CoreWrapper.PlayerCharacter.Id, PerkId, level);
    }

    string ModifierPreface()
    {
        if (Perk?.Skill is not null)
        {
            return Perk.Skill.Name + ": ";
        }
        return (Perk?.ApplyModifiersToOwner ?? true) ? "" : "Target receives: ";
    }

    ActiveSkill? GetPerkSkill()
    {
        if (Perk?.Skill is null || CoreWrapper.PlayerCharacter is null)
            return null;
        var skillComp = CoreWrapper.PlayerCharacter.GetComponent<ActiveSkillComponent>();
        return skillComp?.Skills.FirstOrDefault(s => s.Id == Perk.Skill.Id);
    }
}
