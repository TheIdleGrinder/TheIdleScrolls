@using MiniECS
@using TheIdleScrolls_Core.Components
@using TheIdleScrolls_Core.Modifiers
@using TheIdleScrolls_Web.CoreWrapper

@if (Evasion)
{
    <div class="compact-bar-container withTooltip">
        <div class="compact-bar-frame">
            <center>Evasion</center>
            <div class="compact-bar-fill @(EvasionClass)" style="width: @($"{GetEvasionPct():0%}");"></div>
        </div>
        <span class="barTooltip">
            ??
        </span>
    </div>
}


<style>
    .evasion-bar-active {
        background-color: var(--color-active);
    }

    .evasion-bar-inactive {
        background-color: var(--color-inactive);
    }

</style>

@code {
    [Parameter]
    public Entity? Entity { get; set; }

    ChanceChargeComponent? ChanceChargeComp => Entity?.GetComponent<ChanceChargeComponent>();
    bool Evasion => Entity?.GetComponent<DefenseComponent>() != null;
    double EvasionPct => ChanceChargeComp?.GetCharge("Evasion") ?? 0.0;
    bool EvasionActive => EvasionPct > 1.0;
    string EvasionClass => EvasionActive ? "evasion-bar-active" : "evasion-bar-inactive";

    double GetEvasionPct()
    {
        if (!Evasion)
            return 0.0;
        return Math.Clamp(EvasionPct, 0.0, 1.0);
    }
}
