@using TheIdleScrolls_Core.Skills
@using TheIdleScrolls_Web.CoreWrapper

@inject CoreWrapperModel CoreWrapper

<div class="skill-progress-bar-container withTooltip" style="margin-top: 0.5rem;">
    <span class=@SkillNameClass()>@Skill.Name</span>

    <div id="skill-bar-frame" class="progressFrame withTooltip" style="justify-content: start">
        <div id="skill-bar-fill" class="progressFill @BarColorClass()" style="width: @($"{CalculateProgress():0%}");"></div>
    </div>
    
    <span class="barTooltip">
        <SkillDisplayTile Skill="@Skill"></SkillDisplayTile>
    </span>

    <div class="skill-buttons">
        <button class="small-button" @onclick="@(() => Move(true))">&#x21E7;</button>
        <button class="small-button" @onclick="@(() => Move(false))">&#x21E9;</button>
        @if (Skill.Enabled && Skill.GetState() != ActiveSkill.State.Unavailable)
        {
            <button class="small-button" @onclick="@(() => SetEnabled(false))">&#x2715;</button>
        }
        else
        {
            <button class="small-button" @onclick="@(() => SetEnabled(true))">&#x271A;</button>
        }
    </div>
</div>

<style>
    .skill-progress-bar-container {
        position: relative;
        display: inline-flex;
        font-size: 0.75rem;
        width: 90%;
        flex-direction: column;
        align-self: center;
    }

    .skill-name {
        font-size: 0.75rem;
    }

    .skill-name-unusable {
        font-size: 0.75rem;
        font-style: italic;
        color: gray;        
        text-decoration: line-through;
    }

    .skill-name-disabled {
        font-size: 0.75rem;
        font-style: italic;
        color: darkgray;
    }

    .skill-buttons {
        display: none;
        position: absolute;
        right: 0.5rem;
        bottom: 0.1rem;
        gap: 0.25rem;
        flex-direction: row;
    }

    .small-button {
        font-size: 0.75rem;
        padding: 0.1rem 0.3rem;
        height: 1.5rem;
        width: 1.5rem;
        min-width: 0px;
        min-height: 0px;
        align-content: center;
    }

    .skill-progress-bar-container:hover .skill-buttons {
        display: flex;
    }

    #skill-bar-frame {
        width: 100%;
        border: 1px solid var(--frame-color);
        background: inherit;
        height: fit-content;
        align-self: center;
    }

    #skill-bar-fill {
        height: 12px;
    }

    .skill-bar-fill-charging {
        background-color: var(--color-attack-progress);
    }
    .skill-bar-fill-active {
        background-color: var(--color-active);
    }
    .skill-bar-fill-cooldown {
        background-color: var(--color-inactive);
    }
</style>

@code {
    [Parameter]
    public ActiveSkill Skill { get; set; }

    public double CalculateProgress()
    {
        double percentage = Skill.Timer.Remaining / (Skill.Timer.CooldownDuration > 0.0 ? Skill.Timer.CooldownDuration : 1.0);
        return Skill.CurrentState switch
        {
            SkillTimer.State.Charging => 1.0 - (Skill.Timer.Remaining / (Skill.Timer.ChargingDuration > 0.0 ? Skill.Timer.ChargingDuration : 1.0)),
            SkillTimer.State.Cooldown => Skill.Timer.Remaining / (Skill.Timer.CooldownDuration > 0.0 ? Skill.Timer.CooldownDuration : 1.0),
            _ => 0.0
        };
    }

    string BarColorClass() => Skill.CurrentState switch
    {
        SkillTimer.State.Charging => "skill-bar-fill-charging",
        SkillTimer.State.Active => "skill-bar-fill-active",
        _ => "skill-bar-fill-cooldown"
    };

    string SkillNameClass() => Skill.GetState() switch
    {
        ActiveSkill.State.Unavailable => "skill-name-unusable",
        ActiveSkill.State.Disabled => "skill-name-disabled",
        ActiveSkill.State.NotUsable => "skill-name-unusable",
        _ => "skill-name"
    };

    void Move(bool up)
    {
        CoreWrapper.InputHandler?.ChangeSkillOrder(CoreWrapper?.Character?.Id ?? 0, Skill.Id, up);
    }

    void SetEnabled(bool enabled)
    {
        CoreWrapper.InputHandler?.SetSkillEnabled(CoreWrapper?.Character?.Id ?? 0, Skill.Id, enabled);
    }
}
