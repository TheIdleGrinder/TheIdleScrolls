@using TheIdleScrolls_Core
@using TheIdleScrolls_Core.Components
@using TheIdleScrolls_Core.Modifiers
@using TheIdleScrolls_Core.Skills
@using TheIdleScrolls_Web.CoreWrapper

@inject CoreWrapperModel CoreWrapper

<div class="skill-display-frame">
    <span class="skill-display-name">@Skill.Name</span>
    <span class="skill-display-tags">@(String.Join(", ", Skill.Tags))</span>
    <div class="skill-display-main">
        @if (Skill.ChargingTime > 0)
        {
            <span>Charging Time: <em>@Skill.ChargingTime.ToString("0.##") seconds</em></span>
        }
        @if (Skill.Timer.ActiveDuration > 0)
        {
            <span>Active Duration: <em>@Skill.Timer.ActiveDuration.ToString("0.##") seconds</em></span>
        }
        @if (Skill.Timer.CooldownDuration > 0)
        {
            <span>Cooldown Duration: <em>@Skill.Timer.CooldownDuration.ToString("0.##") seconds</em></span>
        }
        @if (Skill.Range > 0)
        {
            <span>Range: <em>@Skill.Range.ToString("0.#") m</em></span>
        }

        @if (Skill.ActiveEffects.OnEnter.Count > 0)
        {
            <em><u>On Activation:</u></em>
            @foreach(var effect in Skill.ActiveEffects.OnEnter)
            {
                <div class="skill-display-effect">
                    @foreach (var line in effect.Description.Split('\n'))
                    {
                        <span style="padding-left:@(10 * TabsAtStart(line))px;">
                            @(TabsAtStart(line) > 0 ? "➤ " : "")
                            @line
                        </span>
                    }
                </div>
            }
        }
        @if (Skill.ActiveEffects.WhileIn.Count > 0 || Skill.ActiveEffects.RepeatedWhileIn is not null)
        {
            <em><u>While Active:</u></em>
            @foreach (var effect in Skill.ActiveEffects.WhileIn)
            {
                <div class="skill-display-effect">
                    @foreach (var line in effect.Description.Split('\n'))
                    {
                        <span style="padding-left:@(10 * TabsAtStart(line))px;">
                            @(TabsAtStart(line) > 0 ? "➤ " : "")
                            @line
                        </span>
                    }
                </div>
            }
            @if (Skill.ActiveEffects.RepeatedWhileIn is not null)
            {
                <div class="skill-display-effect">
                    @foreach (var line in Skill.ActiveEffects.RepeatedWhileIn.Description.Split('\n'))
                    {
                        <span style="padding-left:@(10 * TabsAtStart(line))px;">
                            @(TabsAtStart(line) > 0 ? "➤ " : "")
                            @line
                        </span>
                    }
                </div>
            }
        }
        @if (Skill.CooldownEffects.OnEnter.Count > 0)
        {
            <em><u>On End of Duration:</u></em>
            @foreach (var effect in Skill.CooldownEffects.OnEnter)
            {
                <div class="skill-display-effect">
                    @foreach (var line in effect.Description.Split('\n'))
                    {
                        <span style="padding-left:@(10 * TabsAtStart(line))px;">
                            @(TabsAtStart(line) > 0 ? "➤ " : "")
                            @line
                        </span>
                    }
                </div>
            }
        }

    </div>
</div>

<style>
    .skill-display-frame {
        padding: 5px;
        margin-bottom: 0.5rem;
        display: flex;
        flex-direction: column;
        align-items: start;
        width: fit-content;
        background-color: var(--background-secondary);
    }

    .skill-display-name {
        display: inherit;
        font-weight: bold;
        font-size: 1rem;
        align-self: center;
    }

    .skill-display-tags {
        display: inherit;
        font-size: 0.75rem;
        font-style: italic;
        color: gray;
        align-self: center;
    }

    .skill-display-main {
        display: flex;
        flex-direction: column;
        align-items: start;
    }

    .skill-display-effect {
        display: flex;
        flex-direction: column;
        align-items: start;
        font-size: 0.9rem;
    }

</style>

@code {
    [Parameter]
    [EditorRequired]
    public ActiveSkill Skill { get; set; }

    int TabsAtStart(string line)
    {
        int count = 0;
        foreach (char c in line)
        {
            if (c == '\t')
            {
                count++;
            }
            else
            {
                break;
            }
        }
        return count;
    }
}
