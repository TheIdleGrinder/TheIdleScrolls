@using TheIdleScrolls_Core.StatusEffects


<div class="compact-bar-container withTooltip">
    <div class="compact-bar-frame compact-status-frame">
        <center>@Effect.Name</center>
        <div class="compact-bar-fill compact-effect-bar-fill" style="width: @($"{CalculateProgress():0%}");"></div>
    </div>

    <div class="barTooltip">
        <div style="font-weight:bold;">@Effect.Name</div>
        <div class="skill-display-effect status-effect-list">
            @foreach (var line in Effect.Description.Split('\n'))
            {
                @("  ➤") @line
                <br />
            }
        </div>
    </div>
</div>

<style>
    .compact-status-frame {
        
    }

    .compact-effect-bar-fill {
        background-color: aquamarine;
    }

    .status-effect-list {
        text-align: start;
    }
</style>

@code {
    [Parameter]
    [EditorRequired]
    public StatusEffect Effect { get; set; }

    public double CalculateProgress()
    {
        if (Effect.Timer is null)
        {
            return 1.0;
        }
        else
        {
            return (Effect.Timer.Duration > 0) ? Effect.Timer.Remaining / Effect.Timer.Duration : 0.0;
        }
    }
}
