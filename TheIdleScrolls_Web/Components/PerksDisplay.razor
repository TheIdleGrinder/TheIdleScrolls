@using TheIdleScrolls_Core
@using TheIdleScrolls_Core.Components
@using TheIdleScrolls_Core.Modifiers
@using TheIdleScrolls_Web.CoreWrapper
@using TheIdleScrolls_Web.Components.Subcomponents
@using TheIdleScrolls_Web.Services

@implements IDisposable

@inject CoreWrapperModel CoreWrapper
@inject TooltipService TooltipService

<div id="perks-container" 
     @onmouseenter="() => TooltipService.SetContainerActive(true)"
     @onmouseleave="ContainerLeave">

    <div class="perk-categories-list">
        @foreach (var (category, perks) in GetPerksByCategory())
        {
            <div class="perk-category-container">
                @if (category != "")
                {
                    <div class="perk-category-header">@category</div>
                }
                <div class="perks-list">
                    @foreach (var perk in perks.Where(p => p.Modifiers.Count > 0))
                    {
                        <SmallPerkTile PerkId=@perk.Id PerksComp=@PerksComponent IsNew=@(!SeenPerks.Contains(perk.Id)) />
                    }
                </div>
            </div>
        }
    </div>

    @* <div class="perks-list">
        @foreach (var perk in Perks.Where(p => p.Modifiers.Count > 0))
        {
            <SmallPerkTile PerkId=@perk.Id PerksComp=@PerksComponent IsNew=@(!SeenPerks.Contains(perk.Id)) />
        }
    </div> *@

    <div id="perks-header">
        @if ((SkillsComponent?.Skills?.Count ?? 0) > 1)
        {
            <button @onclick="@(() => ShowSkills = !ShowSkills)">@(ShowSkills ? ">>" : "<<") Skills</button>
        }
        <p style="margin-bottom: 0">Points Spent: @PerksUsed / @PerksLimit</p>
        @if (FreePerkPoints > 0)
        {   
            <p id="perks-available-points">@FreePerkPoints Point@(FreePerkPoints == 1 ? "" : "s") Available</p>
        }

        @if (ShowSkills)
        {
            <div class="play-area-frame perks-skill-list-container">
                <div style="font-size:x-large">Skills</div>
                <SkillManagementDisplay Entity="@CoreWrapper.PlayerCharacter"></SkillManagementDisplay>
            </div>
        }

    </div>

    @if (NewPerks > 0)
    {
        <div id="perks-new-indicator">
            @NewPerks newly unlocked!
        </div>
    }

</div>


<style>
    #perks-container {
        display: flex;
        flex-direction: column;
        max-height: 100%;
        overflow-y: auto;
    }

    #perks-header {
        padding: 1.0rem;
        border-top: 2px double var(--frame-color);
        display: flex;
        flex-direction: row;
        justify-content: space-between;
    }

    .perk-categories-list
    {
        display: flex;
        flex-direction: column;

        padding: 5px;
        max-height: 100%;
        overflow-y: auto;
        /* scrollbar-gutter: stable; */
    }

    .perk-category-container
    {
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    #perks-new-indicator {
        position: absolute;
        top: 1rem;
        left: 50%;
        transform: translateX(-50%);
        padding: 5px;
        background-color: palegreen;
        border: 2px solid mediumseagreen;
        color: black;
        font-weight: bold;
        text-align: center;
    }

    #perks-available-points {
        margin-left: 2rem;
        margin-bottom: 0;
        font-weight: bold;
        color: green;        
    }

    .perks-list {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));

        /* padding: 5px;
        max-height: 100%;
        overflow-y: auto; */
    }

    .play-area-frame.perks-skill-list-container {
        display: flex;
        flex-direction: column;
        position: absolute;
        bottom: 2rem;
        right: 100%;
        height: 100%;
        width: 20rem;
        background-color: var(--back-color);
        border-top-right-radius: 0;
        border-bottom-right-radius: 0;
    }

</style>

@code {
    PerksChangedHandler PerksHandler => (_) =>
    {
        if (PerksComponent == null)
            PerksComponent = CoreWrapper.PlayerCharacter?.GetComponent<PerksComponent>();
        CoreWrapper.SeenPerks = Perks.Select(p => p.Id).ToList();
        StateHasChanged();
    };

    protected override void OnInitialized()
    {
        CoreWrapper.GameRunner.GetEventEmitter().PlayerPerksChanged += PerksHandler;
        CoreWrapper.GameRunner.GetEventEmitter().AvailablePerkPointsChanged += (_) => StateHasChanged();
        base.OnInitialized();
        PerksComponent = CoreWrapper.PlayerCharacter?.GetComponent<PerksComponent>();
        SkillsComponent = CoreWrapper.PlayerCharacter?.GetComponent<ActiveSkillComponent>();

        // Save previously seen perks but update the list of seen perks in the CoreWrapper
        SeenPerks = new List<string>(CoreWrapper.SeenPerks);
        CoreWrapper.SeenPerks = Perks.Select(p => p.Id).ToList();
    }

    void IDisposable.Dispose()
    {
        CoreWrapper.GameRunner.GetEventEmitter().PlayerPerksChanged -= PerksHandler;
    }

    PerksComponent? PerksComponent = null;
    ActiveSkillComponent? SkillsComponent = null;
    List<Perk> Perks => PerksComponent?.GetPerks() ?? [];
    int PerksUsed => PerksComponent?.GetUsedPerkPoints() ?? 0;
    int PerksLimit => PerksComponent?.PerkPointLimit ?? 0;
    int FreePerkPoints => PerksLimit - PerksUsed;

    List<(string Category, List<Perk> Perks)> GetPerksByCategory()
    {
        Dictionary<string, List<Perk>> result = [];
        foreach (var perk in Perks)
        {
            string category = GetOrderPrefix(perk) + String.Join(": ", perk.Categories) ?? "";
            if (!result.ContainsKey(category))
                result[category] = [];
            result[category].Add(perk);
        }
        return result
            .OrderBy(t => t.Key)
            .Select(t => (RemoveOrderPrefix(t.Key), t.Value)).ToList();
    }

    List<string> SeenPerks = [];
    int NewPerks => Perks.Count - SeenPerks.Count;

    bool ShowSkills = false;

    private void HideTooltipImmediate()
    {
        TooltipService.HideImmediate();
    }

    private void ContainerLeave()
    {
        TooltipService.SetContainerActive(false);
    }

    private string GetOrderPrefix(Perk perk)
    {
        return $"{perk.GetCategoryOrderPrefix():D4}#";
    }

    private string RemoveOrderPrefix(string category)
    {
        int index = category.IndexOf('#');
        if (index >= 0)
            return category.Substring(index + 1);
        return category;
    }
}
