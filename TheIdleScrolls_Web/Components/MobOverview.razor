@using MiniECS
@using TheIdleScrolls_Core
@using TheIdleScrolls_Core.Components
@using TheIdleScrolls_Core.Modifiers
@using TheIdleScrolls_Core.Skills
@using TheIdleScrolls_Core.StatusEffects
@using TheIdleScrolls_Web.Components.Subcomponents
@using TheIdleScrolls_Web.CoreWrapper

@inject CoreWrapperModel CoreWrapper

<div class="mob-overview-outer">
    <div class="mob-main-area">
        <div class="mob-image-health-container">
            <div class="mob-image-container">
                <img class="pixelart" style="width: @(ImageSize)px; border-bottom: 4px solid black"
                     src="@(GetMobImage())" />
            </div>
            <div class="mob-perks">
                @foreach (var perk in (MobPerks ?? []))
                {
                    <MobPerkDisplayComponent Perk=@perk></MobPerkDisplayComponent>
                }
            </div>
            @if (Mob is not null)
            {
                <div class="mob-base-stats">
                    <span class="mob-name">@Name</span>
                    <span class="mob-level">Level @Level</span>
                </div>
                <div class="fight-bar-frame">
                    <div class="fight-bar-fill healthBar" style="width: @(PctString(Hp, HpMax));"></div>
                </div>
                <p class="healthText">HP: @Hp.ToBigIntString() / @HpMax.ToBigIntString()</p>
                <span class="distanceText">Distance: @Distance m</span>
            }
        </div>
        <div class="mob-perks-skill-status">
            <div class="mob-skills">
                @foreach (var skill in (Skills ?? []))
                {
                    <CompactSkillDisplayComponent Skill="@skill"></CompactSkillDisplayComponent>
                }
            </div>
            <div class="mob-status">
                @foreach (var dotType in DoTs?.ActiveTypes ?? [])
                {
                    <CompactDoTEffectComponent Victim="@Mob" DamageType="@dotType"></CompactDoTEffectComponent>
                }
                @foreach (var status in (StatusEffects ?? []))
                {
                    <CompactStatusEffectComponent Effect="@status"></CompactStatusEffectComponent>
                }
            </div>
        </div>
    </div>    
</div>

<style>
    .mob-overview-outer {
        display: flex;
        flex-direction: column;
        flex: 0 0 auto;
        box-sizing: border-box;
        width: 100%;
    }

    .mob-base-stats {
        display: flex;
        flex-direction: column;
        justify-content: start;
        align-items: center;
        width: fit-content;
    }

    .mob-main-area {
        position: relative;
        display: flex;
        flex-direction: column;
    }

    .mob-name {
        font-size: medium;
    }

    .mob-level {
        font-size: 0.8rem;
    }

    .mob-image-health-container {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .fightInner {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 100%;
    }

    .healthBar {
        background-color: var(--color-hp);
    }

    .healthText {
        color: var(--color-hp);
        margin-bottom: 0px;
    }

    .distanceText {
        color: cornflowerblue;
        margin-bottom: 0px;
    }

    .mob-image-container {
        width: 100%;
        display: flex;
        flex-direction: row;
        justify-content: center;
        padding: 0.25rem;
    }

    .mob-perks {
        display: flex;
        flex-direction: row;
        flex-wrap: wrap;
        gap: 0.25rem;
    }

    .mob-skills {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.25rem;
    }

    .mob-status {
        display: flex;
        flex-direction: row;
        justify-content: center;
        gap: 0.25rem;
    }
</style>


@code {
    [Parameter]
    public Entity? Mob { get; set; }

    string Name => Mob?.GetComponent<NameComponent>()?.Name ?? "???";
    int Level => Mob?.GetComponent<LevelComponent>()?.Level ?? 0;
    int Hp => Mob?.GetComponent<LifePoolComponent>()?.Current ?? 0;
    int HpMax => Mob?.GetComponent<LifePoolComponent>()?.Maximum ?? 0;
    double Distance
    {
        get
        {
            var battler = Mob?.GetComponent<BattlerComponent>()!;
            double distance = battler.Position.DistanceTo(CoreWrapper.PlayerCharacter!.GetComponent<BattlerComponent>()!.Position);
            return Math.Round(distance, 1);
        }
    }
    List<Perk> MobPerks => Mob?.GetComponent<PerksComponent>()?.GetPerks() ?? [];
    List<ActiveSkill> Skills => Mob?.GetComponent<ActiveSkillComponent>()?.Skills ?? [];
    List<StatusEffect> StatusEffects => Mob?.GetComponent<StatusEffectComponent>()?.StatusEffects ?? [];
    DoTComponent? DoTs => Mob?.GetComponent<DoTComponent>();

    string CurrentMobId = "";
    string CurrentMobImage = "";
    bool BigImage => CurrentMobImage.Length > 1000;
    int ImageSize => BigImage ? 224 : 112;

    protected override void OnInitialized()
    {
        CoreWrapper.StateChanged += StateHasChanged;
        base.OnInitialized();
    }

    string PctString(double current, double max)
    {
        return $"{current / max:0%}";
    }

    string GetMobImage()
    {
        string mob = Mob?.GetComponent<MobComponent>()?.Id.ToLower() ?? "";
        if (mob == CurrentMobId)
        {
            return CurrentMobImage;
        }

        CurrentMobId = mob;
        object? mobImage = Assets.Mobs.ResourceManager.GetObject(mob)
                            ?? Assets.Mobs.ResourceManager.GetObject("_default");
        if (mobImage != null)
        {
            string base64 = Convert.ToBase64String((byte[])mobImage);
            CurrentMobImage = $"data:image/png; base64,{base64}";
        }
        else
        {
            CurrentMobImage = "/images/hourglass_broadsword.png";
        }
        return CurrentMobImage;
    }
}