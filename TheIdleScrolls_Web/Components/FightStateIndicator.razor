@using MiniECS
@using TheIdleScrolls_Core.Components
@using TheIdleScrolls_Core.Modifiers
@using TheIdleScrolls_Core.Skills
@using TheIdleScrolls_Core.StatusEffects
@using TheIdleScrolls_Web.Components.Subcomponents
@using TheIdleScrolls_Web.CoreWrapper

@inject CoreWrapperModel CoreWrapper

<div class="fight-outer">
    
    @if (MobPresent)
    {
        <div class="fight-image-and-bars">
            <div id="imageContainer">
                <img class="pixelart" style="width: @(ImageSize)px; border-bottom: 4px solid black"
                    src="@(GetMobImage())" />
            </div>

            <div class="fight-bars">
                <div class="fightInner">
                    <span class="fight-mob-name">@MobName (Level @MobLevel)</span>
                    <div class="fight-bar-frame">
                        <div class="fight-bar-fill healthBar" style="width: @(PctString(Hp, HpMax));"></div>
                    </div>
                    <p class="healthText">HP: @Hp.ToBigIntString() / @HpMax.ToBigIntString()</p>
                </div>
    
@*                 @if (TimeActive)
                {
                    <div class="fightInner">
                        <p class="timeText">Time Limit</p>
                        <div class="fight-bar-frame">
                            <div class="fight-bar-fill timeBar" style="width: @(PctString(Time, TimeMax));"></div>
                        </div>
                        <p class="timeText">Remaining: @(GetTimeString(Time)) / @(GetTimeString(TimeMax))</p>
                    </div>
                } *@
            </div>
        </div>

        <div class="mob-perks">
            @foreach (var perk in MobPerks)
            {
                <MobPerkDisplayComponent Perk=@perk></MobPerkDisplayComponent>
            }
        </div>

        <CompactSkillAndStatusDisplay Entity="@Mob" />

    }  
    
</div>

<style>
    #imageContainer {
        width: 100%;
        padding: 0.5rem;
        display: flex;
        flex-direction: row;
        justify-content: center;
    }

    div.fight-outer {
        width: 100%;
        display: flex;
        flex-direction: column;
        background-color: var(--back-color);
    }

    .fight-mob-name {
        white-space: nowrap;
    }

    div.fight-bars {
        display: flex;
        flex-direction: column;
    }

    div.fightInner {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .fight-image-and-bars {
        display: flex;
        flex-direction: row;
    }

    .fight-bar-frame {
        display: flex;
        position: relative;
        flex-direction: row;
        width: 90%;
        background: slategray;
        justify-content: center;
        padding: 0px;
    }

    .fight-bar-fill {
        height: 24px;
        border-style: none;
    }

    .timeBar {
        background-color: var(--color-time);
    }

    .timeText {
        color: var(--color-time);
        margin-bottom: 0px;
    }

    .healthBar {
        background-color: var(--color-hp);
    }

    .healthText {
        color: var(--color-hp);
        margin-bottom: 0px;
    }

    .evasion-bar-active {
        background-color: var(--color-active);
    }

    .evasion-bar-inactive {
        background-color: var(--color-inactive);
    }

    #evasion-progress-frame {
        display: inline-flex;
        font-size: 0.75rem;
        width: 90%;
        flex-direction: column;
        align-self: center;
    }

    #evasion-bar-frame {
        width: 100%;
        border: 1px solid var(--frame-color);
        background: inherit;
        height: fit-content;
        align-self: center;
    }

    #evasion-bar-fill {
        height: 12px;
    }
</style>

@code {
    bool MobPresent => CoreWrapper.Mob.HpMax > 0;
    bool TimeActive => CoreWrapper.TimeLimit.Maximum > 0 && CoreWrapper.Mob.Damage > 0.0;

    bool BigImage => CurrentMobImage.Length > 1000;
    int ImageSize => BigImage ? 224 : 112;

    Entity? Mob => CoreWrapper.PlayerCharacter?.GetComponent<BattlerComponent>()?.Battle?.Mob;
    string MobName => Mob?.GetComponent<NameComponent>()?.Name ?? "???";
    int MobLevel => Mob?.GetComponent<LevelComponent>()?.Level ?? 0;
    int Hp => Mob?.GetComponent<LifePoolComponent>()?.Current ?? 0;
    int HpMax => Mob?.GetComponent<LifePoolComponent>()?.Maximum ?? 0;
    List<Perk> MobPerks => Mob?.GetComponent<PerksComponent>()?.GetActivePerks() ?? [];
    List<ActiveSkill>? MobSkills => Mob?.GetComponent<ActiveSkillComponent>()?.Skills;
    List<StatusEffect>? MobEffects => Mob?.GetComponent<StatusEffectComponent>()?.StatusEffects;

    double Time => CoreWrapper.TimeLimit.Remaining;
    double TimeMax => CoreWrapper.TimeLimit.Maximum;

    List<ActiveSkill>? PlayerSkills => CoreWrapper.PlayerCharacter?.GetComponent<ActiveSkillComponent>()?.Skills;
    List<StatusEffect>? PlayerEffects => CoreWrapper.PlayerCharacter?.GetComponent<StatusEffectComponent>()?.StatusEffects;

    EvaderComponent? Evader => CoreWrapper.PlayerCharacter?.GetComponent<EvaderComponent>();
    bool Evasion => Evader != null;
    bool EvasionActive => Evader?.Active ?? false;
    double EvasionPct => Evader != null ? (1.0 - Evader.Duration.Remaining / Evader.Duration.Duration) : 0.0;
    string EvasionClass => "progressFill " + (EvasionActive ? "evasion-bar-active" : "evasion-bar-inactive");

    string CurrentMobId = "";
    string CurrentMobImage = "";

    protected override void OnInitialized()
    {
        CoreWrapper.StateChanged += StateHasChanged;
        base.OnInitialized();
    }

    string GetTimeString(double time)
    {
        return $"{time:0.###} s";
    }

    string PctString(double current, double max)
    {
        return $"{current / max:0%}";
    }

    int TimeToInt(double time)
    {
        return (int)(time * 1000);
    }

    double GetEvasionPct()
    {
        if (Evader == null)
            return 0.0;
        return !EvasionActive 
            ? (1.0 - Evader.Duration.Remaining / Evader.Duration.Duration) 
            : Evader.Duration.Remaining / Evader.Duration.Duration;
    }

    string GetMobImage()
    {
        string mob = CoreWrapper.Mob.Id.ToLower();
        if (mob == CurrentMobId)
        {
            return CurrentMobImage;
        }

        CurrentMobId = mob;
        object? mobImage = Assets.Mobs.ResourceManager.GetObject(mob) 
                            ?? Assets.Mobs.ResourceManager.GetObject("_default");
        if (mobImage != null)
        {
            string base64 = Convert.ToBase64String((byte[])mobImage);
            CurrentMobImage = $"data:image/png; base64,{base64}";
        }
        else
        {
            CurrentMobImage = "/images/hourglass_broadsword.png";
        }
        return CurrentMobImage;
    }    
}
